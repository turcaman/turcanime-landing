---
import '../styles/global.css';
import { release } from '../lib/release';
import { faq } from '../lib/faq';

interface Props {
	title: string;
}

const { title } = Astro.props;

const metaDescription =
	'Descargá Turcanime para Android, Windows o Linux. App nativa de anime, sin publicidad y sin cuentas.';

const siteUrl = Astro.url.origin;
const ogImage = new URL('/og-image.jpg', Astro.url).href;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			name: 'Turcanime',
			operatingSystem: 'Android',
			applicationCategory: 'Multimedia',
			description:
				'App nativa de anime para Android. Sin publicidad, sin cuentas.',
			version: release.android.version,
			downloadUrl: release.android.apkUrl,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		},
		{
			'@type': 'SoftwareApplication',
			name: 'Turcanime Desktop',
			operatingSystem: 'Windows, Linux',
			applicationCategory: 'Multimedia',
			description:
				'App de escritorio de Turcanime para Windows y Linux. Sin publicidad, sin cuentas.',
			version: release.desktop.version,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		},
		{
			'@type': 'WebSite',
			name: 'Turcanime',
			alternateName: 'Turcanime App',
			url: siteUrl,
			description:
				'App de anime para Android, Windows y Linux. Sin publicidad, sin cuentas.',
			inLanguage: 'es',
			sameAs: [
				'https://github.com/turcaman/turcanime',
				'https://github.com/turcaman/turcanime-desktop',
			],
		},
		{
			'@type': 'Organization',
			name: 'Turcanime',
			url: siteUrl,
			sameAs: [
				'https://github.com/turcaman/turcanime',
				'https://github.com/turcaman/turcanime-desktop',
			],
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Turcanime',
					item: `${siteUrl}/`,
				},
			],
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map(({ q, a }) => ({
				'@type': 'Question',
				name: q,
				acceptedAnswer: { '@type': 'Answer', text: a },
			})),
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#000000" />
		<link rel="canonical" href={Astro.url} />

		<meta name="description" content={metaDescription} />
		<meta name="robots" content="index, follow" />
		<meta name="google-site-verification" content="inisPcLQqbRi1tEyPP_nFq2EmMI54_cXhb_QIFlcTaw" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:site_name" content="Turcanime" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Turcanime: kanji sobre fondo negro" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Turcanime: kanji sobre fondo negro" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-bg text-text-primary font-sans antialiased">
		<slot />
	</body>
</html>
