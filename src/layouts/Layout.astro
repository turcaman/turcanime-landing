---
import '../styles/global.css';
import { release } from '../lib/release';

interface Props {
	title: string;
}

const { title } = Astro.props;

const metaDescription =
	'Descargá Turcanime para Android, Windows o Linux. App nativa de anime, sin publicidad y sin cuentas.';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			name: 'Turcanime',
			operatingSystem: 'Android',
			applicationCategory: 'Multimedia',
			description:
				'App nativa de anime para Android. Sin publicidad, sin cuentas.',
			version: release.android.version,
			downloadUrl: release.android.apkUrl,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		},
		{
			'@type': 'SoftwareApplication',
			name: 'Turcanime Desktop',
			operatingSystem: 'Windows, Linux',
			applicationCategory: 'Multimedia',
			description:
				'App de escritorio de Turcanime para Windows y Linux. Sin publicidad, sin cuentas.',
			version: release.desktop.version,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
		},
		{
			'@type': 'WebSite',
			name: 'Turcanime',
			alternateName: 'Turcanime App',
			url: 'https://turcanime.pages.dev',
			description:
				'App de anime para Android, Windows y Linux. Sin publicidad, sin cuentas.',
			inLanguage: 'es',
			sameAs: [
				'https://github.com/turcaman/turcanime',
				'https://github.com/turcaman/turcanime-desktop',
			],
		},
		{
			'@type': 'Organization',
			name: 'Turcanime',
			url: 'https://turcanime.pages.dev',
			sameAs: [
				'https://github.com/turcaman/turcanime',
				'https://github.com/turcaman/turcanime-desktop',
			],
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Turcanime',
					item: 'https://turcanime.pages.dev/',
				},
			],
		},
		{
			'@type': 'FAQPage',
			mainEntity: [
				{
					'@type': 'Question',
					name: '¿Es gratis?',
					acceptedAnswer: { '@type': 'Answer', text: 'Sí, completamente gratis en todas las plataformas. Sin suscripciones, sin compras, sin publicidad.' },
				},
				{
					'@type': 'Question',
					name: '¿En qué sistemas funciona?',
					acceptedAnswer: { '@type': 'Answer', text: 'Android (teléfonos y tablet), Windows 10+ y Linux (x86_64, con paquetes .deb y .rpm).' },
				},
				{
					'@type': 'Question',
					name: '¿Qué requisitos tiene el escritorio?',
					acceptedAnswer: { '@type': 'Answer', text: 'Windows 10+ o cualquier distribución Linux x86_64 reciente. No necesita cuenta ni configuración especial: descargás el instalador y listo.' },
				},
				{
					'@type': 'Question',
					name: '¿Necesito root o permisos especiales?',
					acceptedAnswer: { '@type': 'Answer', text: 'No. En Android funciona en cualquier equipo estándar sin root. En escritorio, solo seguís el asistente de instalación normal de tu sistema.' },
				},
				{
					'@type': 'Question',
					name: '¿Qué hago si no carga un video?',
					acceptedAnswer: { '@type': 'Answer', text: 'La app reintenta automáticamente si hay un error de conexión. Si el problema persiste, entrá a Ajustes > Renovar conexión para refrescar la sesión.' },
				},
				{
					'@type': 'Question',
					name: '¿Es segura?',
					acceptedAnswer: { '@type': 'Answer', text: 'No guarda ni envía ningún dato personal. Todo queda en tu dispositivo, sin rastreo ni cuentas.' },
				},
				{
					'@type': 'Question',
					name: '¿Se actualiza sola?',
					acceptedAnswer: { '@type': 'Answer', text: 'No tiene auto-actualización. Cuando hay una versión nueva, la app te avisa y descargás el instalador desde la página de descargas.' },
				},
				{
					'@type': 'Question',
					name: '¿Sirve en tablet o TV?',
					acceptedAnswer: { '@type': 'Answer', text: 'En tablet funciona, aunque la interfaz está optimizada para teléfonos.' },
				},
				{
					'@type': 'Question',
					name: '¿En qué se diferencia de otras apps?',
					acceptedAnswer: { '@type': 'Answer', text: 'No es un sitio web disfrazado de app. Está hecha como app nativa en cada plataforma, sin publicidad, sin cuentas y sin rastreo. Funciona en Android, Windows y Linux.' },
				},
			],
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="canonical" href={Astro.url} />

		<meta name="description" content={metaDescription} />
		<meta name="keywords" content="Turcanime, anime APK, ver anime en Android, app anime para PC, Turcanime Desktop, streaming anime gratis, app anime sin anuncios, descargar anime Windows Linux Android" />
		<meta name="robots" content="index, follow" />
		<meta name="google-site-verification" content="inisPcLQqbRi1tEyPP_nFq2EmMI54_cXhb_QIFlcTaw" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:site_name" content="Turcanime" />
		<meta property="og:image" content="https://turcanime.pages.dev/og-image.webp" />
		<meta property="og:image:width" content="1024" />
		<meta property="og:image:height" content="1024" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content="https://turcanime.pages.dev/og-image.webp" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-bg text-text-primary font-sans antialiased scanlines">
		<slot />
	</body>
</html>
