---
import { Monitor, Lock, Clock } from '@lucide/astro';

const features = [
  {
    icon: Monitor,
    title: 'Donde la uses, corre nativa',
    desc: 'App nativa para Android, app de escritorio para Windows y Linux. Cada plataforma con sus propios controles y su interfaz.',
  },
  {
    icon: Lock,
    title: 'Sin cuentas, sin publicidad',
    desc: 'No hay registro, no hay anuncios, no hay notificaciones. Todo queda en tu dispositivo.',
  },
  {
    icon: Clock,
    title: 'Tu progreso se guarda solo',
    desc: 'Cada episodio se marca automáticamente. Cerrás la app y volvés exactamente donde lo dejaste.',
  },
];
---

<section class="px-5 py-24 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">Diferencias que importan</h2>
    <p class="text-text-secondary text-center text-sm mb-14 max-w-lg mx-auto">
      App nativa, sin cuentas, sin publicidad. Así debería funcionar.
    </p>

    <div class="grid md:grid-cols-3 gap-5">
      {features.map(({ icon: Icon, title, desc }) => (
        <div class="card-feature">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-5">
            <Icon size={20} class="text-primary" />
          </div>
          <h3 class="font-bold text-lg mb-2 text-white">{title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
