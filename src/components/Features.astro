---
import { Monitor, Lock, Clock, RefreshCw, Search, Bell } from '@lucide/astro';

const features = [
  {
    icon: Monitor,
    title: 'Nativa en cada plataforma',
    desc: 'Nativa en Android, de escritorio en Windows y Linux. Cada una con sus controles y su interfaz.',
  },
  {
    icon: RefreshCw,
    title: 'Se actualiza desde la app',
    desc: 'Cuando hay versión nueva, te avisa y la descargás con progreso desde Ajustes. En Android y Windows se abre el instalador; en Linux el AppImage se reemplaza solo.',
  },
  {
    icon: Search,
    title: 'Buscador con memoria',
    desc: 'Sugerencias mientras escribís, búsquedas recientes a un toque y Ctrl+K en escritorio.',
  },
  {
    icon: Lock,
    title: 'Sin cuentas, sin publicidad',
    desc: 'No hay registro, no hay anuncios, no hay notificaciones. Todo queda en tu dispositivo.',
  },
  {
    icon: Clock,
    title: 'Tu progreso se guarda solo',
    desc: 'Cada episodio se marca automáticamente. Cerrás la app y volvés exactamente donde lo dejaste.',
  },
  {
    icon: Bell,
    title: 'Si un video falla, reintenta solo',
    desc: 'Si un video no carga, la app reintenta y renueva la sesión sola. También podés renovarla desde Ajustes.',
  },
];
---

<section class="px-5 py-24 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">Nativa, sin cuentas, sin publicidad</h2>
    <p class="text-text-secondary text-center text-sm mb-14 max-w-lg mx-auto">
      Así funciona.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map(({ icon: Icon, title, desc }) => (
        <div class="card-feature">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-5">
            <Icon size={20} class="text-primary" />
          </div>
          <h3 class="font-bold text-lg mb-2 text-white">{title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
