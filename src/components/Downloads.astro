---
import { Download } from '@lucide/astro';
import { release } from '../lib/release';

const platforms = [
  {
    name: 'Android',
    version: `v${release.android.version}`,
    meta: 'APK',
    href: release.android.apkUrl,
  },
  {
    name: 'Windows',
    version: `v${release.desktop.version}`,
    meta: '.exe',
    href: release.desktop.windows.exeUrl,
  },
  {
    name: 'Linux',
    version: `v${release.desktop.version}`,
    meta: '.AppImage',
    href: release.desktop.linux.appImageUrl,
  },
];
---

<section id="descargas" class="px-5 py-24 border-t border-border">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">Descargas</h2>
    <p class="text-text-secondary text-center text-sm mb-12 max-w-lg mx-auto">
      Elegí tu plataforma y descargá la app.
    </p>

    <div class="flex flex-wrap gap-4 justify-center">
      {platforms.map(({ name, version, meta, href }) => (
        <div class="card-feature flex items-center justify-between gap-4 w-full sm:w-[calc(50%-0.5rem)]">
          <div class="min-w-0">
            <h3 class="font-bold text-white text-lg leading-tight">{name}</h3>
            <span class="text-xs text-text-secondary font-mono">{version} · {meta}</span>
          </div>

          <a
            href={href}
            aria-label={`Descargar para ${name} (${meta})`}
            class="btn-primary inline-flex items-center justify-center gap-2 shrink-0"
          >
            <Download size={16} />
            Descargar
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
